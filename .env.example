# .env 模板：cp .env.example .env 后填入真实值（.env 已被 .gitignore 排除）
# 凭证获取：安卓 App 抓包任意 api.bilibili.com 请求的 query 参数（ACCESS_KEY/CSRF），
# 网页 Cookie 里的 SESSDATA/bili_jct/DeduUserID
BILI_ACCESS_KEY=
BILI_CSRF=
BILI_SESSDATA=
BILI_BILI_JCT=
BILI_DEDE_USER_ID=

# 邮件推送（选配）：推荐留空、在仪表盘网页里配置（存 notify.json）。
# 注意：这里填了会以环境变量优先级压住网页配置（host/port 也会压）。
# 示例：BILI_SMTP_HOST=smtp.qq.com  BILI_SMTP_PORT=465 或 587(STARTTLS)
BILI_SMTP_HOST=
BILI_SMTP_PORT=
BILI_SMTP_USER=
BILI_SMTP_PASS=
BILI_NOTIFY_TO=
